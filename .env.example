# =====================================================================
#  Stardew Monitor — configuração
#  Copie para ".env" e ajuste. O ".env" NUNCA vai para o Git.
#  Todas as variáveis são opcionais; os valores abaixo são os padrões.
# =====================================================================

# ---------------------------------------------------------------------
#  SERVIDOR (backend + painel)
# ---------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Pasta de dados (banco SQLite e o segredo gerado automaticamente)
DATA_DIR=./data

# Banco de dados:
#   SQLite (instalação individual, padrão):  sqlite:./data/stardew.db
#   PostgreSQL (várias máquinas):           postgres://usuario:senha@host:5432/stardew
DATABASE_URL=
# TLS para PostgreSQL gerenciado: "true" (verifica certificado) ou "no-verify"
DATABASE_SSL=

# Segredo usado para criptografar as credenciais salvas pelo painel (Discord, Telegram, SMTP).
# Mínimo de 32 caracteres. Se ficar vazio, um segredo é gerado e salvo em data/.app-secret.
# ATENÇÃO: se você trocar este valor, as credenciais já salvas no painel deixam de ser legíveis.
APP_SECRET=

# Administrador inicial (criado só se ainda não existir nenhum usuário).
# Sem ADMIN_PASSWORD, uma senha aleatória é gerada e mostrada UMA vez no log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sessão (horas) e cookie seguro: auto (usa HTTPS se a requisição for HTTPS) | true | false
SESSION_TTL_HOURS=12
COOKIE_SECURE=auto
# Atrás de proxy reverso (Nginx, Caddy, Render...): número de proxies confiáveis (ex.: 1)
TRUST_PROXY=

# Monitorar a própria máquina onde o servidor roda (o "agente embutido").
# Em hospedagens na nuvem, isso mostra as métricas DO SERVIDOR, não do seu PC.
LOCAL_MONITOR=true
LOCAL_INTERVAL=5
LOCAL_FARM_NAME=Fazenda Principal
# Windows: processo PowerShell persistente para rede, disco e LibreHardwareMonitor
WINDOWS_HELPER=true

# "Expulsar morador" (encerrar processos da máquina local). Exige admin + senha + confirmação.
ALLOW_PROCESS_KILL=true
# Nomes extras protegidos, separados por vírgula (ex.: postgres,nginx)
PROTECTED_PROCESSES=

# Resumo público SEM dados sensíveis (só nome da fazenda, status e percentuais)
PUBLIC_DASHBOARD=false

# Compatibilidade com o agente PHP antigo (legacy/agente-stardew.cjs): token para /api/dados
LEGACY_API_TOKEN=

# Limites de requisições
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_AGENT_PER_MIN=240
RATE_LIMIT_KILL_PER_MIN=10

# Nível de log: debug | info | warn | error | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------
#  CANAIS DE NOTIFICAÇÃO (opcional)
#  Podem ser definidos aqui OU pelo painel (Avisos > Canais), onde ficam criptografados.
#  Valores definidos aqui têm prioridade e não podem ser alterados pelo painel.
# ---------------------------------------------------------------------
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ---------------------------------------------------------------------
#  AGENTE (em cada máquina monitorada — veja docs/agente.md)
# ---------------------------------------------------------------------
# Endereço do servidor central (use https:// na internet)
STARDEW_SERVER_URL=
# Token gerado em Pelican Town > Registrar fazenda (mostrado uma única vez)
STARDEW_AGENT_TOKEN=
STARDEW_INTERVAL=10
# Permitir que o servidor peça para encerrar processos nesta máquina (padrão: não)
STARDEW_ALLOW_REMOTE_KILL=false
# Aceitar http:// para servidor remoto (NÃO recomendado)
STARDEW_ALLOW_INSECURE=false
# Enviar a lista de processos a cada N segundos (0 = só quando alguém abrir a página)
STARDEW_PROCESS_EVERY=0
STARDEW_PROTECTED=

# ---------------------------------------------------------------------
#  MODO LEGADO (hospedagem PHP, versão 2) — veja docs/legado-php.md
# ---------------------------------------------------------------------
PAINEL_URL=
PAINEL_TOKEN=
PAINEL_INTERVALO=5
PAINEL_LOCAL=http://localhost:3001
PAINEL_SENHA=
