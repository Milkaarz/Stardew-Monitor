# Copie este arquivo para ".env" e preencha. O ".env" NÃO vai para o GitHub.
# Usado só pelo agente (agente.js), que envia os dados do seu PC para o site.

# Endereço do receber.php na sua hospedagem (inclua a pasta, se houver)
PAINEL_URL=https://seudominio.com/receber.php

# Mesma senha que está em $TOKEN no receber.php do servidor
PAINEL_TOKEN=troque-esta-senha

# De quantos em quantos minutos o agente envia (padrão: 5)
PAINEL_INTERVALO=5
