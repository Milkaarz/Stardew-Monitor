{
  "name": "stardew-monitor",
  "version": "3.0.0",
  "private": true,
  "description": "Monitor de hardware e recursos do sistema com visual de fazenda em pixel art: backend Express, agente leve, frontend Preact e banco SQLite/PostgreSQL.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "shared",
    "database",
    "agent",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node backend/src/index.js",
    "dev": "node --watch backend/src/index.js",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "agent": "node agent/src/index.js",
    "migrate": "node database/src/cli.js",
    "create-admin": "node backend/src/cli/create-admin.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:pg": "node --test --test-concurrency=1 \"tests/integration/*.test.js\" \"tests/api/*.test.js\"",
    "check": "npm run lint && npm test && npm run build",
    "agente:php": "node --env-file=.env legacy/agente-stardew.cjs",
    "pm2": "pm2 start ecosystem.config.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "supertest": "^7.3.2"
  }
}
